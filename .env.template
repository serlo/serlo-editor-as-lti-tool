# Template for .env file in local development - Copy content to `.env` file and add missing secret values

# 'local', 'development', 'staging' or 'production'
ENVIRONMENT=local

# Using 'production' everywhere like Node.js recommends
# https://nodejs.org/en/learn/getting-started/nodejs-the-difference-between-development-and-production
NODE_ENV=production

EDITOR_URL=http://localhost:3000/

# (Deprecated) Secret to enable media upload
SERLO_EDITOR_TESTING_SECRET=

# HS256 secret key - Generated by `yarn generate-secret`
# Used by ltijs to sign ltik and database entries & to sign the jwt access token
# 256 bits encoded as base64
# ltijs uses function nodejs.crypto.createPrivateKey(key) and the key should have format 'PEM (base64)' https://nodejs.org/api/crypto.html#cryptocreateprivatekeykey
LTIJS_KEY=

# Databases
MYSQL_URI=mysql://root:secret@localhost:3306/serlo
MONGODB_URI=mongodb://localhost:27017/lti

# Assets bucket
S3_ENDPOINT=https://s3.eu-central-3.ionoscloud.com/
BUCKET_NAME=editor-media-assets-development
BUCKET_REGION=eu-central-3
MEDIA_BASE_URL=https://editor.serlo.dev
BUCKET_ACCESS_KEY_ID=placeholder
BUCKET_SECRET_ACCESS_KEY=placeholder

OPENAI_API_KEY=placeholder

# Keep an empty line at the end
